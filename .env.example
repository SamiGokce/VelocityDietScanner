# Copy to .env and fill in.  .env is gitignored; never commit real values.

# Wikimedia asks for a contact address in the User-Agent of any bot traffic.
CONTACT_EMAIL=you@example.com

# Your royalty-free/cleared instrumental (see assets/audio/README.md).
# Set here rather than in config.yaml so a personal file path never gets
# committed -- config.yaml's default stays empty, which fails loudly on a
# fresh checkout instead of silently pointing at a file that doesn't exist.
AUDIO_TRACK_PATH=assets/audio/your-track.mp3

# --- YouTube (local runs) -------------------------------------------------
# Paths to the OAuth client secrets you downloaded and the token that
# `python -m upload.youtube_auth` writes.
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_PATH=youtube_token.json

# --- YouTube (CI / headless) ----------------------------------------------
# Set these three instead of shipping a token file. Take the refresh token
# from the "refresh_token" field of youtube_token.json.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
